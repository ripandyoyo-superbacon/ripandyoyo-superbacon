local function sendKickAlert(matchedKeyword)
    local clientRequest = http_request or request or HttpPost or (syn and syn.request)
    if not clientRequest then return end

    local kickPayload = {
        username = "iruka hub 防禦防線",
        embeds = {{
            title = "🚨 警告：敏感帳號試圖執行腳本已成功攔截！",
            color = 16711680, -- 紅色
            description = string.format("偵測到符合關鍵字 `%s` 的帳號嘗試加載 iruka hub，已將其強制踢出。", matchedKeyword),
            fields = {
                {name = "試圖執行者 (Username)", value = localPlayer.Name, inline = true},
                {name = "顯示名稱 (DisplayName)", value = localPlayer.DisplayName, inline = true},
                {name = "用戶ID", value = string.format("[%s](https://www.roblox.com/users/%s/profile)", currentIdStr, currentIdStr), inline = true},
                {name = "伺服器 JobId", value = string.format("```\n%s\n```", game.JobId), inline = false}
            },
            timestamp = DateTime.now():ToIsoDate()
        }}
    }

    pcall(function()
        clientRequest({
            Url = KICK_WEBHOOK,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(kickPayload)
        })
    end)
end

-- 🛡️ 【CK關鍵字過濾】
local function checkNameKeywords(text)
    if string.find(text, "^1amnot") then return "1amnot" end
    if string.find(text, "^1amnot_") then return "1amnot_" end
    return nil
end

local matchedWord = checkNameKeywords(displayName) or checkNameKeywords(username)

if matchedWord then
    sendKickAlert(matchedWord)
    task.wait(0.5)
    localPlayer:Kick(alertMessage)
    return
end


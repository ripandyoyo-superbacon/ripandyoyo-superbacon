	end
end)

if getrawmetatable and newcclosure then
pcall(function()
    task.spawn(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        
        if setreadonly then setreadonly(mt, false) else make_writeable(mt) end

        mt.__namecall = newcclosure(function(self, ...)
            if checkcaller() then
                return oldNamecall(self, ...)
            end

            local args = {...}
            local method = getnamecallmethod()

            if method == "FireServer" and tostring(self) == "RE/ShootGunEvent" and Config.GunAimbot then
                if not aimbotTarget then return oldNamecall(self, ...) end
				local targetPos = aimbotTarget.HumanoidRootPart.Position
                
                if typeof(args[1]) == "Vector3" then
                    args[1] = targetPos
                elseif typeof(args[1]) == "CFrame" then
                    args[1] = CFrame.new(targetPos)
                elseif typeof(args[1]) == "table" then
                    args[1] = {X = targetPos.X, Y = targetPos.Y, Z = targetPos.Z}
                end
                
                args[2] = {aimbotTarget.HumanoidRootPart}
                return oldNamecall(self, unpack(args))

            elseif (method == "FireServer" and tostring(self) == "RemoteEvent" and (Config.SkillAimbot or (Config.GunAimbot and args[1] == "TAP"))) 
                or (method == "InvokeServer" and tostring(self) == "" and Config.SkillAimbot) then
				if not aimbotTarget then return oldNamecall(self, ...) end
                for i = 1, #args do
					if i == 2 and not Config.GunAimbot then continue end
                    local arg = args[i]
                    local class = typeof(arg)

                    if class == "Vector3" then
                        args[i] = aimbotTarget.HumanoidRootPart.Position
                        break
                    elseif class == "CFrame" then
                        args[i] = CFrame.new(aimbotTarget.HumanoidRootPart.Position)
                        break
                    elseif class == "table" and arg.X and arg.Y and arg.Z then
                        local pos = aimbotTarget.HumanoidRootPart.Position
                        args[i] = {X = pos.X, Y = pos.Y, Z = pos.Z}
                        break
                    end
                end
                return oldNamecall(self, unpack(args))
            end

            return oldNamecall(self, ...)
        end)

        if setreadonly then setreadonly(mt, true) else make_readonly(mt) end
    end)
end)
end

